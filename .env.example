PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Required for AI-generated scan results.
OPENAI_API_KEY=
BROGRADE_AI_MODEL=gpt-5.5
BROGRADE_AI_FALLBACK_MODELS=gpt-5.1,gpt-5
BROGRADE_AI_REASONING_EFFORT=medium

# Optional email delivery through Resend.
RESEND_API_KEY=
RESEND_FROM="BroGrade <getbrograde@gmail.com>"
BROGRADE_ADMIN_EMAIL=getbrograde@gmail.com

# Paid Full Audit checkout through Stripe.
STRIPE_SECRET_KEY=
BROGRADE_AUDIT_PRICE_CENTS=1900
BROGRADE_AUDIT_CURRENCY=usd
BROGRADE_AUDIT_DELIVERY_WINDOW=24-48 hours
BROGRADE_AUDIT_REVISION_POLICY=One actionability revision included during beta.

# Local development only. Shows a test button that skips Stripe checkout.
BROGRADE_DEV_CHECKOUT_BYPASS=false

# Keep this private. Used to generate protected admin photo links.
SCAN_SIGNING_SECRET=replace-with-a-long-random-secret

# Local private upload and record storage.
BROGRADE_STORAGE_DIR=storage
